{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:notetaker:speech-result:1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "window_id", "sample_rate", "window_start_sample", "window_end_sample", "segments", "outcome"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "window_id": { "type": "string", "minLength": 1 },
    "sample_rate": { "type": "integer", "minimum": 8000, "maximum": 192000 },
    "window_start_sample": { "type": "integer", "minimum": 0 },
    "window_end_sample": { "type": "integer", "minimum": 1 },
    "outcome": { "enum": ["speech", "silence", "uncertain"] },
    "segments": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "start_sample", "end_sample", "text", "stability", "confidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "start_sample": { "type": "integer", "minimum": 0 },
          "end_sample": { "type": "integer", "minimum": 1 },
          "text": { "type": "string", "minLength": 1, "maxLength": 12000 },
          "stability": { "enum": ["provisional", "stable"] },
          "confidence": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "value"],
            "properties": { "kind": { "enum": ["uncalibrated_score", "unavailable"] }, "value": { "type": ["number", "null"] } }
          }
        }
      }
    }
  }
}
