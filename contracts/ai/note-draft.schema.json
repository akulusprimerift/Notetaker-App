{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["blocks", "issues"],
  "properties": {
    "blocks": {"type": "array", "minItems": 1, "maxItems": 100, "items": {
      "type": "object", "additionalProperties": false, "required": ["topic", "kind", "passages"],
      "properties": {
        "topic": {"type": "string", "minLength": 1, "maxLength": 200},
        "kind": {"enum": ["definition", "explanation", "procedure", "example", "qualification", "emphasis", "uncertainty", "code", "equation"]},
        "passages": {"type": "array", "minItems": 1, "maxItems": 30, "items": {
          "type": "object", "additionalProperties": false, "required": ["text", "source_ids"],
          "properties": {
            "text": {"type": "string", "minLength": 1, "maxLength": 12000},
            "source_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string"}}
          }
        }}
      }
    }},
    "issues": {"type": "array", "maxItems": 100, "items": {
      "type": "object", "additionalProperties": false, "required": ["code", "detail", "source_ids"],
      "properties": {
        "code": {"enum": ["missing_visual", "unclear_audio", "source_conflict", "incomplete_evidence"]},
        "detail": {"type": "string", "minLength": 1, "maxLength": 2000},
        "source_ids": {"type": "array", "maxItems": 200, "uniqueItems": true, "items": {"type": "string"}}
      }
    }}
  }
}
