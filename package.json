{
  "name": "notetaker-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local lecture notes workspace, service foundation and evaluation contracts.",
  "workspaces": ["apps/web"],
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test tests/architecture/reference-model.test.mjs tests/ai/contracts.test.mjs",
    "test:architecture": "node --test tests/architecture/reference-model.test.mjs",
    "test:ai": "node --test tests/ai/contracts.test.mjs",
    "verify:docs": "pwsh -NoProfile -File scripts/Verify-PlanningDocs.ps1",
    "eval:notes": "node scripts/evaluate-notes.mjs",
    "dev:web": "npm run dev --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web"
  },
  "devDependencies": { "ajv": "8.20.0" }
}
