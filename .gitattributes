# Auto detect text files and perform LF normalization
* text=auto

# Preserve the original Markdown's intentional two-space line breaks in the archive.
docs/archive/original-spec-v0.2.md whitespace=-blank-at-eol
# Preserve upstream license whitespace and reStructuredText heading markers.
apps/desktop/third-party/native/** whitespace=-blank-at-eol,-blank-at-eof conflict-marker-size=256
