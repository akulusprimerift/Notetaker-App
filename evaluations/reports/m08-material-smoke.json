        "id": "b1",
        "topic": "Binary Search Requirements and Comparison Bound",
        "kind": "definition",
        "passages": [
          {
            "id": "b1p1",
            "text": "Binary search requires the input array to be sorted. The algorithm compares the target value with the middle element of the current search range. If the target is found, the search terminates; otherwise, the algorithm discards the half of the array that cannot contain the target and repeats the process on the remaining half.",
            "evidence_kind": "lecture_paraphrase",
            "sources": [
              {
                "source_id": "speech-test",
                "quote": "Binary search requires sorted input. Compare the middle element with the target. Discard the half that cannot contain it, then repeat.",
                "occurrence": 0
              }
            ]
          },
          {
            "id": "b1p2",
            "text": "The maximum number of comparisons required for binary search on an array of size n (where n > 0) is given by the formula: floor(log\u2082(n)) + 1. For empty arrays, no comparisons are needed.",
            "evidence_kind": "material_paraphrase",
            "sources": [
              {
                "source_id": "material:synthetic:0",
                "quote": "Binary search comparison bound: at most floor(log2(n)) + 1 comparisons for n greater than zero. Empty arrays require no comparisons.",
                "occurrence": 0
              }
            ]
          }
        ]
      }
    ],
