FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/apps/api HF_HUB_OFFLINE=1
COPY apps/api/requirements-speech.lock /app/requirements.lock
RUN pip install --no-cache-dir --require-hashes -r requirements.lock
COPY apps/api/notetaker /app/apps/api/notetaker
CMD ["python", "-m", "notetaker.speech_worker"]
