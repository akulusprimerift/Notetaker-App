<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's V8 and the frozen Python service need JIT/unsigned memory under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key><true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <!-- Bundled PostgreSQL/Python extension libraries are loaded by path. -->
  <key>com.apple.security.cs.disable-library-validation</key><true/>
  <!-- Recording starts only when the student presses Record; macOS still asks first. -->
  <key>com.apple.security.device.audio-input</key><true/>
</dict>
</plist>
